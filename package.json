{
  "name": "orbit-game-launcher",
  "version": "1.0.0",
  "description": "A cinematic desktop home for your PC games",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/brand.cjs && vite build",
    "start": "npm run build && node scripts/start.cjs",
    "smoke": "npm run build && node scripts/start.cjs --smoke",
    "check:home": "npm run build && node scripts/check-carousel.cjs",
    "record:demo": "npm run build && node scripts/start.cjs --record-demo",
    "test": "node --test",
    "package": "npm run build && node scripts/package.cjs",
    "check:types": "tsc --noEmit",
    "check:ui": "npm run build && node scripts/check-fluid.cjs",
    "check:catalogue": "node scripts/check-catalogue.cjs",
    "cache:catalogue": "node scripts/cache-catalogue.cjs",
    "installer": "npm run package && electron-builder --win nsis --prepackaged release/Orbit"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "rcedit": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "author": "Orbit"
}
